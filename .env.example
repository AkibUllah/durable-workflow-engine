# SQLite file by default; for PostgreSQL use postgresql://user:pass@host:5432/db
# (postgres:// URLs from hosting providers are accepted too).
DATABASE_URL=sqlite:///./durable.db

# Optional shared secret; when set, /v1/* requires the X-API-Key header.
# API_KEY=replace-with-a-long-random-string

LOG_LEVEL=INFO

# Run worker threads inside the API process. Turn off when you run `durable worker` separately.
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2

# A task whose worker goes silent for this long is handed to another worker.
LEASE_SECONDS=30
POLL_INTERVAL=0.5
